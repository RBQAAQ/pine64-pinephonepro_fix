diff --git a/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c b/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
--- a/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
+++ b/drivers/media/platform/rockchip/rkisp1/rkisp1-capture.c
@@ -1096,6 +1096,12 @@
 				      info->bpp[i];
 		plane->sizeimage = plane->bytesperline *
 				   DIV_ROUND_UP(pixm->height, info->vdiv);
+		/* RK3399 NV12 chroma DMA ring sizes must cover complete cache-
+		 * line bursts. Keep row pitch and the Y/UV boundary unchanged;
+		 * only pad the final chroma allocation/ring size. */
+		if ((pixm->pixelformat == V4L2_PIX_FMT_NV12 ||
+		     pixm->pixelformat == V4L2_PIX_FMT_NV21) && i == 1)
+			plane->sizeimage = ALIGN(plane->sizeimage, 64);
 	}
 
 	/*
diff --git a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
--- a/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
+++ b/drivers/gpu/drm/rockchip/dw-mipi-dsi-rockchip.c
@@ -1538,6 +1538,15 @@
 static int rk3399_dphy_tx1rx1_power_on(struct phy *phy)
 {
 	struct dw_mipi_dsi_rockchip *dsi = phy_get_drvdata(phy);
+	int ret;
+
+	/* Restore RX1 -> ISP1 for every streaming session. Firmware or
+	 * suspend can change the shared GRF after the one-time phy_init().
+	 * ISP0 remains connected to its dedicated RX0 PHY. */
+	ret = regmap_write(dsi->grf_regmap, RK3399_GRF_SOC_CON24,
+			   HIWORD_UPDATE(0, RK3399_TXRX_SRC_SEL_ISP0));
+	if (ret)
+		return ret;
 
 	/* tester reset pulse */
 	dsi_write(dsi, DSI_PHY_TST_CTRL0, PHY_TESTCLK | PHY_TESTCLR);
