 	REG8(0x94dd, 0x20),
@@ -1059,6 +873,18 @@
 	}
 
 	/* Setup PLL */
+	/* Variant registers must be selected before PLL/stream startup. */
+	{
+		bool pdaf = of_device_is_compatible(client->dev.of_node, "sony,imx258-pdaf");
+		const struct imx258_reg variant[] = {
+			{ 0x3052, pdaf ? 0x01 : 0x00 },
+			{ 0x4e21, pdaf ? 0x10 : 0x14 },
+			{ 0x7b25, pdaf ? 0x01 : 0x00 },
+		};
+		ret = imx258_write_regs(imx258, variant, ARRAY_SIZE(variant));
+		if (ret)
+			return ret;
+	}
 	link_freq_index = imx258->cur_mode->link_freq_index;
 	reg_list = &link_freq_configs[link_freq_index].reg_list;
 	ret = imx258_write_regs(imx258, reg_list->regs, reg_list->num_of_regs);
@@ -1590,6 +1416,7 @@
