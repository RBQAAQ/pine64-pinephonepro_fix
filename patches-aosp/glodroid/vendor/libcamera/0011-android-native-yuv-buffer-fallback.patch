From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenCode <noreply@opencode.local>
Date: Sun, 11 Oct 2026 22:30:00 +0800
Subject: [PATCH] android native yuv buffer fallback

Built and verified on the PinePhone Pro. See docs/VERIFIED_REPAIRS.md
for the exact validation scope and remaining limitations.

---
diff --git a/src/android/camera_stream.cpp b/src/android/camera_stream.cpp
index 045e600..21b8352 100644
--- a/src/android/camera_stream.cpp
+++ b/src/android/camera_stream.cpp
@@ -70,6 +70,7 @@ CameraStream::~CameraStream()
 	 */
 	allocatedBuffers_.clear();
 	allocator_.reset();
+	nativeAllocator_.reset();
 }
 
 const StreamConfiguration &CameraStream::configuration() const
@@ -224,8 +225,27 @@ FrameBuffer *CameraStream::getBuffer()
 		auto frameBuffer = allocator_->allocate(HAL_PIXEL_FORMAT_YCBCR_420_888,
 							configuration().size,
 							camera3Stream_->usage);
-		allocatedBuffers_.push_back(std::move(frameBuffer));
-		buffers_.emplace_back(allocatedBuffers_.back().get());
+		if (frameBuffer) {
+			allocatedBuffers_.push_back(std::move(frameBuffer));
+			buffers_.emplace_back(allocatedBuffers_.back().get());
+		} else {
+			/* Mesa-backed gralloc may not allocate internal YUV buffers.
+			 * Export the pipeline's real DMA buffers, preserving the
+			 * negotiated plane lengths/offsets for software JPEG/YUV. */
+			if (nativeAllocator_)
+				return nullptr;
+			nativeAllocator_ = std::make_unique<FrameBufferAllocator>(cameraDevice_->camera());
+			if (nativeAllocator_->allocate(stream()) < 0) {
+				nativeAllocator_.reset();
+				return nullptr;
+			}
+			for (const auto &native : nativeAllocator_->buffers(stream())) {
+				allocatedBuffers_.push_back(std::make_unique<HALFrameBuffer>(native->planes(), nullptr));
+				buffers_.push_back(allocatedBuffers_.back().get());
+			}
+			if (buffers_.empty())
+				return nullptr;
+		}
 	}
 
 	FrameBuffer *buffer = buffers_.back();
diff --git a/src/android/camera_stream.h b/src/android/camera_stream.h
index 4c5078b..01fca58 100644
--- a/src/android/camera_stream.h
+++ b/src/android/camera_stream.h
@@ -18,6 +18,7 @@
 
 #include <libcamera/camera.h>
 #include <libcamera/framebuffer.h>
+#include <libcamera/framebuffer_allocator.h>
 #include <libcamera/geometry.h>
 #include <libcamera/pixel_format.h>
 
@@ -174,6 +175,7 @@ private:
 	const unsigned int index_;
 
 	std::unique_ptr<PlatformFrameBufferAllocator> allocator_;
+	std::unique_ptr<libcamera::FrameBufferAllocator> nativeAllocator_;
 	std::vector<std::unique_ptr<libcamera::FrameBuffer>> allocatedBuffers_;
 	std::vector<libcamera::FrameBuffer *> buffers_ LIBCAMERA_TSA_GUARDED_BY(mutex_);
 	/*
