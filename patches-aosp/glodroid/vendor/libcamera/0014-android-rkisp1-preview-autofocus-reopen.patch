diff --git a/src/ipa/rkisp1/algorithms/af.cpp b/src/ipa/rkisp1/algorithms/af.cpp
new file mode 100644
--- /dev/null
+++ b/src/ipa/rkisp1/algorithms/af.cpp
@@ -0,0 +1,231 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* RKISP1 ISP-statistics based autofocus. ISP AFC setup follows the public
+ * 2023 RKISP1 AF proposal by Daniel Semkowicz (Theobroma Systems).
+ * The bounded coarse/fine scan and Android pause behavior are implemented
+ * here for this older IPA ABI; front fixed-focus sensors remain unchanged. */
+#include "af.h"
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <libcamera/control_ids.h>
+
+namespace libcamera::ipa::rkisp1::algorithms {
+LOG_DEFINE_CATEGORY(RkISP1Af)
+
+int Af::init(IPAContext &, const YamlObject &tuning)
+{
+	wait_ = std::clamp(tuning["wait-frames-lens"].get<uint32_t>(2), 1U, 10U);
+	warmup_ = std::clamp(tuning["warmup-frames"].get<uint32_t>(12), 0U, 60U);
+	threshold_ = tuning["isp-threshold"].get<uint32_t>(128);
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPACameraSensorInfo &info)
+{
+	mode_ = controls::AfModeManual;
+	state_ = controls::AfStateIdle;
+	positions_.clear();
+	paused_ = pauseDeferred_ = false;
+	settling_ = false;
+	moving_ = false;
+	configureWindow_ = true;
+	skip_ = warmup_;
+	cooldown_ = lowContrast_ = 0;
+	reference_ = referenceSum_ = 0;
+	referenceSamples_ = 0;
+	if (!context.configuration.lens.available)
+		return 0;
+	if (context.configuration.lens.maximum <= context.configuration.lens.minimum)
+		return -EINVAL;
+	/* Stay away from sensor borders, use an even central metering window. */
+	unsigned int width = std::max(16U, info.outputSize.width / 3) & ~1U;
+	unsigned int height = std::max(16U, info.outputSize.height / 3) & ~1U;
+	window_ = { static_cast<uint16_t>((info.outputSize.width - width) / 2 & ~1U),
+		    static_cast<uint16_t>((info.outputSize.height - height) / 2 & ~1U),
+		    static_cast<uint16_t>(width), static_cast<uint16_t>(height) };
+	/* Establish a known actuator origin at stream start, including AF OFF.
+	 * The first IPA start emits this control before any result metadata. */
+	move(context, context.configuration.lens.minimum);
+	skip_ = std::max(skip_, warmup_);
+	return 0;
+}
+
+void Af::move(IPAContext &context, int32_t position)
+{
+	context.activeState.af.position = std::clamp(position,
+		context.configuration.lens.minimum, context.configuration.lens.maximum);
+	context.activeState.af.update = true;
+	moving_ = true;
+	skip_ = wait_;
+	samples_ = 0;
+	score_ = 0;
+	LOG(RkISP1Af, Debug) << "AF lens position " << context.activeState.af.position;
+}
+
+void Af::beginScan(IPAContext &context)
+{
+	const auto &lens = context.configuration.lens;
+	positions_.clear();
+	for (int i = 0; i <= 8; ++i)
+		positions_.push_back(lens.minimum + (lens.maximum - lens.minimum) * i / 8);
+	index_ = 0;
+	fine_ = false;
+	settling_ = false;
+	best_ = 0;
+	lowest_ = std::numeric_limits<double>::max();
+	bestPosition_ = lens.minimum;
+	state_ = controls::AfStateScanning;
+	unsigned int warmup = skip_;
+	move(context, positions_[0]);
+	skip_ = std::max(skip_, warmup);
+	LOG(RkISP1Af, Info) << "AF scan started, range " << lens.minimum << ".." << lens.maximum;
+}
+
+void Af::queueRequest(IPAContext &context, uint32_t, IPAFrameContext &, const ControlList &request)
+{
+	if (!context.configuration.lens.available)
+		return;
+	if (auto position = request.get(controls::draft::AfLensPositionUncalibrated);
+	    position && std::isfinite(*position) &&
+	    request.get(controls::AfMode).value_or(mode_) == controls::AfModeManual) {
+		const auto &lens = context.configuration.lens;
+		int32_t target = lens.minimum + std::lround(std::clamp(*position, 0.0f, 1.0f) *
+			(lens.maximum - lens.minimum));
+		if (target != context.activeState.af.position)
+			move(context, target);
+	}
+	if (auto mode = request.get(controls::AfMode); mode && *mode != mode_) {
+		mode_ = *mode;
+		paused_ = pauseDeferred_ = false;
+		positions_.clear();
+		state_ = controls::AfStateIdle;
+		settling_ = false;
+		if (mode_ == controls::AfModeContinuous)
+			beginScan(context);
+	}
+	if (auto pause = request.get(controls::AfPause); pause && mode_ == controls::AfModeContinuous) {
+		if (*pause == controls::AfPauseResume) {
+			paused_ = pauseDeferred_ = false;
+		} else if (*pause == controls::AfPauseImmediate) {
+			paused_ = true;
+		} else {
+			pauseDeferred_ = state_ == controls::AfStateScanning;
+			paused_ = !pauseDeferred_;
+		}
+	}
+	if (auto trigger = request.get(controls::AfTrigger); trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart && state_ != controls::AfStateScanning)
+			beginScan(context);
+		else if (*trigger == controls::AfTriggerCancel) {
+			positions_.clear();
+			state_ = controls::AfStateIdle;
+			settling_ = false;
+		}
+	}
+}
+
+void Af::prepare(IPAContext &context, uint32_t, IPAFrameContext &, rkisp1_params_cfg *params)
+{
+	if (!context.configuration.lens.available || !configureWindow_)
+		return;
+	params->meas.afc_config.num_afm_win = 1;
+	params->meas.afc_config.thres = threshold_;
+	params->meas.afc_config.var_shift = 4;
+	params->meas.afc_config.afm_win[0] = window_;
+	params->module_cfg_update |= RKISP1_CIF_ISP_MODULE_AFC;
+	params->module_ens |= RKISP1_CIF_ISP_MODULE_AFC;
+	params->module_en_update |= RKISP1_CIF_ISP_MODULE_AFC;
+	configureWindow_ = false;
+}
+
+void Af::metadata(const IPAContext &context, ControlList &result) const
+{
+	result.set(controls::AfState, state_);
+	const auto &lens = context.configuration.lens;
+	result.set(controls::draft::AfLensPositionUncalibrated,
+		static_cast<float>(context.activeState.af.position - lens.minimum) /
+		(lens.maximum - lens.minimum));
+	result.set(controls::draft::AfLensMoving, moving_);
+	result.set(controls::AfPauseState, paused_ ? controls::AfPauseStatePaused :
+		pauseDeferred_ ? controls::AfPauseStatePausing : controls::AfPauseStateRunning);
+}
+
+void Af::process(IPAContext &context, uint32_t, IPAFrameContext &,
+		 const rkisp1_stat_buffer *stats, ControlList &result)
+{
+	if (!context.configuration.lens.available)
+		return;
+	metadata(context, result);
+	if (paused_ || !stats || !(stats->meas_type & RKISP1_CIF_ISP_STAT_AFM))
+		return;
+	if (skip_) { if (!--skip_) moving_ = false; return; }
+	if (settling_) {
+		settling_ = false;
+		state_ = settledState_;
+		paused_ = pauseDeferred_;
+		pauseDeferred_ = false;
+		metadata(context, result);
+		LOG(RkISP1Af, Info) << "AF scan finished position " << bestPosition_ << " state " << state_
+			<< " contrast " << best_;
+		return;
+	}
+	const auto &af = stats->params.af.window[0];
+	if (!af.lum)
+		return;
+	/* Use the ISP's actual sharpness measure. Luminance can have transient
+	 * low samples in binned mode; dividing by its square turned those into
+	 * false focus peaks even when the sharpness itself remained low. */
+	double contrast = static_cast<double>(af.sum);
+	if (!std::isfinite(contrast))
+		return;
+	if (state_ != controls::AfStateScanning) {
+		/* Establish CAF tracking from the settled lens, not the maximum
+		 * measured while the lens/exposure were sweeping. */
+		if (state_ == controls::AfStateFocused && referenceSamples_ < 8) {
+			referenceSum_ += contrast;
+			if (++referenceSamples_ == 8)
+				reference_ = referenceSum_ / referenceSamples_;
+			return;
+		}
+		if (cooldown_) { --cooldown_; return; }
+		if (mode_ == controls::AfModeContinuous && !pauseDeferred_ && reference_ > 0) {
+			lowContrast_ = contrast < reference_ * 0.55 ? lowContrast_ + 1 : 0;
+			if (lowContrast_ >= 8) { lowContrast_ = 0; beginScan(context); }
+		}
+		return;
+	}
+	score_ += contrast;
+	if (++samples_ < 2)
+		return;
+	double score = score_ / samples_;
+	lowest_ = std::min(lowest_, score);
+	if (score > best_) { best_ = score; bestPosition_ = positions_[index_]; }
+	LOG(RkISP1Af, Debug) << "AF sample " << positions_[index_] << " contrast " << score
+			  << " sum=" << af.sum << " lum=" << af.lum;
+	if (++index_ < positions_.size()) { move(context, positions_[index_]); return; }
+	if (!fine_) {
+		const auto &lens = context.configuration.lens;
+		int32_t radius = std::max(1, (lens.maximum - lens.minimum) / 8);
+		int32_t low = std::max(lens.minimum, bestPosition_ - radius);
+		int32_t high = std::min(lens.maximum, bestPosition_ + radius);
+		positions_.clear();
+		for (int i = 0; i <= 6; ++i) positions_.push_back(low + (high - low) * i / 6);
+		index_ = 0;
+		fine_ = true;
+		/* Fine-pass confidence must not inherit the coarse pass's
+		 * initial exposure transient or an old, incomparable peak. */
+		best_ = 0;
+		lowest_ = std::numeric_limits<double>::max();
+		move(context, positions_[0]);
+		return;
+	}
+	move(context, bestPosition_);
+	settledState_ = best_ > 0 && lowest_ < best_ * 0.9 ? controls::AfStateFocused : controls::AfStateFailed;
+	settling_ = true;
+	reference_ = referenceSum_ = 0;
+	referenceSamples_ = 0;
+	cooldown_ = 90;
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+} /* namespace libcamera::ipa::rkisp1::algorithms */
