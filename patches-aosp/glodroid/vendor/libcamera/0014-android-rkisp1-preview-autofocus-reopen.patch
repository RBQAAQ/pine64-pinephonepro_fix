+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <vector>
+#include "algorithm.h"
+
+namespace libcamera::ipa::rkisp1::algorithms {
+
+/* Bounded contrast scan using the ISP AF statistics, not copied YUV images.
+ * Lens values stay in the V4L2 driver domain; no uncalibrated diopters are
+ * exposed as LensPosition. */
+class Af : public Algorithm
+{
+public:
+	int init(IPAContext &, const YamlObject &) override;
+	int configure(IPAContext &, const IPACameraSensorInfo &) override;
+	void queueRequest(IPAContext &, uint32_t, IPAFrameContext &, const ControlList &) override;
+	void prepare(IPAContext &, uint32_t, IPAFrameContext &, rkisp1_params_cfg *) override;
+	void process(IPAContext &, uint32_t, IPAFrameContext &, const rkisp1_stat_buffer *, ControlList &) override;
+
+private:
+	void beginScan(IPAContext &);
+	void move(IPAContext &, int32_t);
+	void metadata(const IPAContext &, ControlList &) const;
+	std::vector<int32_t> positions_;
+	rkisp1_cif_isp_window window_{};
+	int32_t mode_ = 0, state_ = 0, bestPosition_ = 0;
+	unsigned int index_ = 0, skip_ = 0, samples_ = 0, cooldown_ = 0, lowContrast_ = 0;
+	unsigned int wait_ = 2, warmup_ = 12, threshold_ = 128;
+	double score_ = 0, best_ = 0, lowest_ = 0, reference_ = 0;
+	double referenceSum_ = 0;
+	unsigned int referenceSamples_ = 0;
+	bool configureWindow_ = true, fine_ = false, paused_ = false, pauseDeferred_ = false;
+	bool settling_ = false;
+	bool moving_ = false;
+	int32_t settledState_ = 0;
+};
+
+} /* namespace libcamera::ipa::rkisp1::algorithms */
