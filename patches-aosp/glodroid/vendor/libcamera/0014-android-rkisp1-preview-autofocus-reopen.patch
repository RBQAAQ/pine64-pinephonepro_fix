+	/* Negotiate an aligned INTERNAL capture rectangle. RK3399 can leave
+	 * 64-byte chroma holes for unaligned NV12 image payloads; padding only
+	 * the backing allocation is insufficient. Android sizes stay unchanged
+	 * and software post-processing crops the small extra capture border. */
+	const Size sensorLimit = camera_->properties().get(properties::PixelArraySize).value_or(Size{});
+	for (auto &streamConfig : streamConfigs) {
+		auto &cfg = streamConfig.config;
+		if (cfg.pixelFormat != formats::NV12 ||
+		    (static_cast<uint64_t>(cfg.size.width) * cfg.size.height / 2) % 64 == 0)
+			continue;
+		Size best{};
+		uint64_t bestArea = UINT64_MAX;
+		for (unsigned int dy = 0; dy <= 32; dy += 2) {
+			for (unsigned int dx = 0; dx <= 64; dx += 2) {
+				Size candidate{ cfg.size.width + dx, cfg.size.height + dy };
+				uint64_t area = static_cast<uint64_t>(candidate.width) * candidate.height;
+				if ((area / 2) % 64 || candidate.width > sensorLimit.width ||
+				    candidate.height > sensorLimit.height || area >= bestArea)
+					continue;
+				best = candidate;
+				bestArea = area;
+			}
+		}
+		if (!best.width)
+			return -EINVAL;
+		LOG(HAL, Info) << "Internal chroma-aligned capture " << cfg.size << " -> " << best;
+		cfg.size = best;
+	}
+#endif
