From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenCode <noreply@opencode.local>
Date: Sat, 10 Oct 2026 06:00:00 +0800
Subject: [PATCH] binder: accept pending-frozen oneway acknowledgements

diff --git a/libs/binder/IPCThreadState.cpp b/libs/binder/IPCThreadState.cpp
index a62425e..3dfc5d5 100644
--- a/libs/binder/IPCThreadState.cpp
+++ b/libs/binder/IPCThreadState.cpp
@@ -67,6 +67,10 @@
 
 namespace android {
 
+// Newer Android kernels acknowledge oneway calls queued to frozen processes
+// with this payload-free notification. Older userspace UAPI headers lack it.
+static constexpr uint32_t kTransactionPendingFrozen = _IO('r', 20);
+
 // Static const and functions will be optimized out if not used,
 // when LOG_NDEBUG and references in IF_LOG_COMMANDS() are optimized out.
 static const char *kReturnStrings[] = {
@@ -117,6 +121,7 @@ static const int64_t kWorkSourcePropagatedBitIndex = 32;
 
 static const char* getReturnString(uint32_t cmd)
 {
+    if (cmd == kTransactionPendingFrozen) return "BR_TRANSACTION_PENDING_FROZEN";
     size_t idx = cmd & _IOC_NRMASK;
     if (idx < sizeof(kReturnStrings) / sizeof(kReturnStrings[0]))
         return kReturnStrings[idx];
@@ -918,6 +923,7 @@ status_t IPCThreadState::waitForResponse(Parcel *reply, status_t *acquireResult)
             CallStack::logStack("oneway spamming", CallStack::getCurrent().get(),
                     ANDROID_LOG_ERROR);
             [[fallthrough]];
+        case kTransactionPendingFrozen:
         case BR_TRANSACTION_COMPLETE:
             if (!reply && !acquireResult) goto finish;
             break;
@@ -1367,6 +1373,7 @@ status_t IPCThreadState::executeCommand(int32_t cmd)
         result = TIMED_OUT;
         break;
 
+    case kTransactionPendingFrozen:
     case BR_NOOP:
         break;
 

